# ══════════════════════════════════════════════════════════════════
# RiseBunny Bot — environment (.env.example → .env olarak kopyala)
# Değerlerin nereden alınacağı her satırın yanında yazıyor.
# ══════════════════════════════════════════════════════════════════

# ── Discord ──────────────────────────────────────────────────────
# discord.com/developers → Applications → (botun) → Bot → Reset Token
DISCORD_BOT_TOKEN=
# discord.com/developers → General Information → Application ID
MAIN_GUILD_ID=

# ── Firestore / Firebase Admin (VERİTABANI) ──────────────────────
# Firebase Console → Project Settings → Service Accounts →
#   "Generate new private key" → inen JSON dosyasının YOLU (önerilen):
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# ...VEYA JSON içeriğini tek satır olarak buraya yapıştır (alternatif):
#FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"gen-lang-client-0590499912","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n","client_email":"...","...":"..."}
# Firebase Console → Project Settings → General → projenin kimliği
FIREBASE_PROJECT_ID=gen-lang-client-0590499912

# Web API key (leaderboard REST senkronu için; Console → Project Settings →
#   General → Your apps → Web app → API key)
FIREBASE_API_KEY=AIzaSyAq5Nafl9aI2TabzGsj5J9ij6lNwyfTguM
# Leaderboard'ı Firestore'a yazan bot hesabı (Firebase Console → Authentication →
#   Users → Add user → email/password). rules bu e-postaya yazar:
FIREBASE_BOT_EMAIL=bot@discord.risebunny.local
FIREBASE_BOT_SIFRE=

# ── API güvenliği (site/launcher botun /api/*'sına erişirken) ────
# Kendin üret: openssl rand -hex 32  (site Vercel'deki aynı değer olmalı)
BOT_API_SECRET=
SESSION_SECRET=
TICKET_SECRET=

# ── top.gg ───────────────────────────────────────────────────────
TOPGG_BOT_ID=1540401487581020252
# top.gg → your bot → Manage → Webhooks & API → Bot API Token
TOPGG_TOKEN=
TOPGG_WEBHOOK_SECRET=
TOPGG_REWARD_MONEY=1000
TOPGG_REWARD_XP=150
TOPGG_REWARD_ROLE_ID=

# ── AI (opsiyonel) ───────────────────────────────────────────────
# console.groq.com/keys
GROQ_API_KEY=
